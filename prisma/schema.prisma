// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model LeetCodeAccount {
  id           String   @id @default(cuid())
  clerkUserId  String   @unique
  username     String
  lastSyncedAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  submissions  LeetCodeSubmission[]
}

model LeetCodeProblem {
  id               String   @id @default(cuid())
  questionNumber   String   @unique
  title            String
  titleSlug        String   @unique
  difficulty       String
  topicTags        String[]
  url              String?
  submissions      LeetCodeSubmission[]
  concepts         Concept[]
}

model LeetCodeSubmission {
  id               String   @id @default(cuid())
  accountId        String
  account          LeetCodeAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  problemId        String
  problem          LeetCodeProblem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  submissionId     String?  // Not making this @unique yet as some submissions might lack stable IDs, we'll index it instead.
  verdict          String
  language         String
  timestamp        DateTime
  runtime          String?
  memory           String?
  sourceCode       String?  @db.Text
  failureAnalyses  FailureAnalysis[]
  concepts         Concept[]

  @@unique([accountId, submissionId]) // Prevent duplicate submissions where stable ID exists
  @@index([accountId])
  @@index([problemId])
}

// Phase 4: "Why Did I Fail?" — stores AI-generated diagnosis of a failed submission.
model FailureAnalysis {
  id                 String   @id @default(cuid())
  clerkUserId        String
  submissionId       String
  submission         LeetCodeSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  rootCause          String   @db.Text
  failureCategory    String
  concept            String
  evidence           String   @db.Text
  preventionRule     String   @db.Text
  suggestedFollowUp  String   @db.Text
  failingTestCase    Json?
  aiModel            String
  createdAt          DateTime @default(now())

  @@index([clerkUserId])
  @@index([submissionId])
}

// Phase 5: Concept Extraction — the core algorithmic concept behind an
// accepted submission (one per user per problem; re-extracting reuses this row).
model Concept {
  id             String   @id @default(cuid())
  clerkUserId    String
  problemId      String
  problem        LeetCodeProblem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  submissionId   String?
  submission     LeetCodeSubmission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  name           String
  coreIdea       String   @db.Text
  invariant      String   @db.Text
  aiModel        String
  createdAt      DateTime @default(now())
  microProofs    MicroProof[]

  @@unique([clerkUserId, problemId])
  @@index([clerkUserId])
  @@index([submissionId])
}

// Phase 5: Active-Recall Micro-Proof — a short conceptual question generated
// from a Concept. The question itself is persistent; each time the user
// answers it, a separate MicroProofAttempt is recorded (never overwritten).
model MicroProof {
  id                String    @id @default(cuid())
  clerkUserId       String
  conceptId         String
  concept           Concept   @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  question          String    @db.Text
  expectedPoints    Json
  aiModel           String
  createdAt         DateTime  @default(now())
  attempts          MicroProofAttempt[]

  @@index([clerkUserId])
  @@index([conceptId])
}

// Phase 5: One evaluated attempt at answering a MicroProof. A user may
// re-attempt the same MicroProof; each attempt is preserved independently.
model MicroProofAttempt {
  id                String    @id @default(cuid())
  microProofId      String
  microProof        MicroProof @relation(fields: [microProofId], references: [id], onDelete: Cascade)
  clerkUserId       String
  answer            String    @db.Text
  score             Int
  understanding     String
  whatWasCorrect    String    @db.Text
  missingPoints     Json
  feedback          String    @db.Text
  aiModel           String
  createdAt         DateTime  @default(now())
  // Phase 7: the revision interval that was computed immediately after this
  // attempt (null for attempts made before Phase 7, or if it wasn't tied to
  // a concept with a mastery record yet). Denormalized purely so the
  // Revision History view can show "Review N -> score -> interval" without
  // having to re-derive a point-in-time value from current data.
  intervalDaysAfterReview Int?

  @@index([clerkUserId])
  @@index([microProofId])
}

// Phase 6: Concept Mastery — a deterministic, explainable rollup of Phase 4
// (failure history) and Phase 5 (micro-proof performance, successful
// problems) signals for one user's understanding of one normalized concept.
// Recalculated server-side whenever new relevant data appears; never set by hand.
model ConceptMastery {
  id                       String   @id @default(cuid())
  clerkUserId              String
  concept                  String
  masteryScore             Int
  status                   String
  totalMicroProofAttempts  Int      @default(0)
  averageMicroProofScore   Float?
  failureCount             Int      @default(0)
  successfulProblemCount   Int      @default(0)
  lastEvaluatedAt          DateTime
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  revisionSchedule         RevisionSchedule?

  @@unique([clerkUserId, concept])
  @@index([clerkUserId])
  @@index([masteryScore])
  @@index([status])
}

// Phase 7: Adaptive Revision — a deterministic spaced-repetition-style
// schedule for one user's normalized concept. Created on the concept's
// first Micro-Proof evaluation and updated on every subsequent review.
// The (clerkUserId, concept) pair doubles as the FK into ConceptMastery,
// so a schedule can only exist for a concept with real learning evidence.
model RevisionSchedule {
  id                   String   @id @default(cuid())
  clerkUserId          String
  concept              String
  mastery              ConceptMastery @relation(fields: [clerkUserId, concept], references: [clerkUserId, concept], onDelete: Cascade)
  nextReviewAt         DateTime
  lastReviewedAt       DateTime
  reviewCount          Int      @default(0)
  currentIntervalDays  Int
  lastScore            Int
  status               String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([clerkUserId, concept])
  @@index([clerkUserId])
  @@index([nextReviewAt])
}
